# ---------------------------------------------------------------
# Gouri Travels — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in the browser, protected by RLS)
SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for local scripts / seeding (NEVER expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site base URL, used for links in emails
SITE_URL=http://localhost:5173
