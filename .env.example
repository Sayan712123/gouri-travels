# ---------------------------------------------------------------
# Gouri Travels — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).
# ---------------------------------------------------------------

# ---- the site itself -------------------------------------------
# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://kjoynpeidivqqanwfsno.supabase.co

# Supabase anon / publishable key (safe in the browser, protected by RLS)
SUPABASE_ANON_KEY=sb_publishable_-zosCdXmn_UzfvHMeXSXLw_smvznBnY

# ---- only for `npm run supabase:setup` -------------------------
# Pick ONE of the three options below. Nothing here is ever
# committed, and none of it is used by the website itself.

# Option A — database password (Project Settings -> Database)
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_PROJECT_REF=kjoynpeidivqqanwfsno
# SUPABASE_DB_REGION=ap-south-1

# Option B — full connection string (Project Settings -> Database -> URI)
# DATABASE_URL=postgresql://postgres.kjoynpeidivqqanwfsno:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Option C — personal access token (https://supabase.com/dashboard/account/tokens)
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_PROJECT_REF=kjoynpeidivqqanwfsno

# ---- optional --------------------------------------------------
# Public site base URL, used for links in emails
SITE_URL=https://sayan712123.github.io/gouri-travels
